# Application
APP_NAME=gymtracker-backend
APP_ENV=development
LOG_LEVEL=info

# Backend HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=3000
BACKEND_URL=http://localhost:8080
BACKEND_URL_CONTAINER=http://backend:8080

# Authentication placeholders. Generate distinct random values (at least 32
# characters) in the untracked .env file; never reuse these example strings.
JWT_ACCESS_SECRET=replace-with-distinct-random-access-secret
JWT_REFRESH_SECRET=replace-with-distinct-random-refresh-secret
JWT_ISSUER=gymtracker-api
JWT_ACCESS_AUDIENCE=gymtracker-web
JWT_REFRESH_AUDIENCE=gymtracker-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
REFRESH_COOKIE_NAME=gymtracker_refresh
REFRESH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m

# Local PostgreSQL placeholders; replace them in an untracked .env file.
POSTGRES_DB=gymtracker
POSTGRES_USER=gymtracker
POSTGRES_PASSWORD=change-me-local-only

# DATABASE_URL is for Go commands running on the host. DATABASE_URL_CONTAINER
# is for Compose services. URL-encode special characters in credentials and
# keep both URLs aligned with the POSTGRES_* values above.
DATABASE_URL=postgres://gymtracker:change-me-local-only@localhost:5432/gymtracker?sslmode=disable
DATABASE_URL_CONTAINER=postgres://gymtracker:change-me-local-only@postgres:5432/gymtracker?sslmode=disable

# PostgreSQL pool and readiness
DB_CONNECT_TIMEOUT=5s
DB_PING_TIMEOUT=2s
DB_MIN_CONNS=1
DB_MAX_CONNS=10
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m

# Local maintenance and integration tests. TEST_DATABASE_URL must name a
# dedicated disposable database; integration tests perform full up/down.
MIGRATIONS_PATH=migrations
TEST_DATABASE_URL=postgres://gymtracker:change-me-local-only@localhost:5432/gymtracker_test?sslmode=disable
