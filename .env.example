# Application
APP_NAME=gymtracker-backend
APP_ENV=development
LOG_LEVEL=info

# Backend HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=3000

# Local PostgreSQL placeholders; replace them in an untracked .env file.
POSTGRES_DB=gymtracker
POSTGRES_USER=gymtracker
POSTGRES_PASSWORD=change-me-local-only

# DATABASE_URL is for Go commands running on the host. DATABASE_URL_CONTAINER
# is for Compose services. URL-encode special characters in credentials and
# keep both URLs aligned with the POSTGRES_* values above.
DATABASE_URL=postgres://gymtracker:change-me-local-only@localhost:5432/gymtracker?sslmode=disable
DATABASE_URL_CONTAINER=postgres://gymtracker:change-me-local-only@postgres:5432/gymtracker?sslmode=disable

# PostgreSQL pool and readiness
DB_CONNECT_TIMEOUT=5s
DB_PING_TIMEOUT=2s
DB_MIN_CONNS=1
DB_MAX_CONNS=10
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m

# Local maintenance and integration tests. TEST_DATABASE_URL must name a
# dedicated disposable database; integration tests perform full up/down.
MIGRATIONS_PATH=migrations
TEST_DATABASE_URL=postgres://gymtracker:change-me-local-only@localhost:5432/gymtracker_test?sslmode=disable
